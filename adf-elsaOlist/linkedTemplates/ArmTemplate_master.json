{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-elsaOlist"
		},
		"AzureSQLTargetConnection_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQLTargetConnection'"
		},
		"Ls_AzureDataLakeRaw_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Ls_AzureDataLakeRaw'"
		},
		"AzureSQLTargetConnection_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "olistecomerceserver.database.windows.net"
		},
		"AzureSQLTargetConnection_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "olistecomercedb"
		},
		"AzureSQLTargetConnection_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admincharishma"
		},
		"Http_Source_Github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"Ls_AzureDataLakeRaw_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://elsaoliststorageaccount.dfs.core.windows.net/"
		},
		"ls_response_to_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/RabbitIntoCode/ORS-Db-Dev/tree/develop/Requiremnt_based_Brazillian_Ecomerce_Data"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-elsaOlist_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSQLTargetConnection_password": {
						"value": "[parameters('AzureSQLTargetConnection_password')]"
					},
					"Ls_AzureDataLakeRaw_accountKey": {
						"value": "[parameters('Ls_AzureDataLakeRaw_accountKey')]"
					},
					"AzureSQLTargetConnection_properties_typeProperties_server": {
						"value": "[parameters('AzureSQLTargetConnection_properties_typeProperties_server')]"
					},
					"AzureSQLTargetConnection_properties_typeProperties_database": {
						"value": "[parameters('AzureSQLTargetConnection_properties_typeProperties_database')]"
					},
					"AzureSQLTargetConnection_properties_typeProperties_userName": {
						"value": "[parameters('AzureSQLTargetConnection_properties_typeProperties_userName')]"
					},
					"Http_Source_Github_properties_typeProperties_url": {
						"value": "[parameters('Http_Source_Github_properties_typeProperties_url')]"
					},
					"Ls_AzureDataLakeRaw_properties_typeProperties_url": {
						"value": "[parameters('Ls_AzureDataLakeRaw_properties_typeProperties_url')]"
					},
					"ls_response_to_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_response_to_adls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}